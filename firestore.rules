rules_version = '2';

// Access control for both apps. The client app and the admin app use the
// same Firebase project; what an account may do depends only on whether its
// uid has a document in /admins (created by hand in the Firebase console).
//
// The project is on the free Spark plan (no Cloud Functions), so these rules
// are the only server-side guard. They can't loop over an order's product
// lines, so prices are not verified here: the admin app flags orders whose
// prices don't match the catalogue (payment happens on site anyway).
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isShortString(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function pad4(n) {
      return n < 10 ? '000' + string(n)
        : n < 100 ? '00' + string(n)
        : n < 1000 ? '0' + string(n)
        : string(n);
    }

    // yyyyMMdd of the request, in UTC (up to 2h behind French time, which
    // only makes the "not in the past" check slightly lenient after midnight).
    function todayKey() {
      return string(request.time.year()) + pad2(request.time.month()) + pad2(request.time.day());
    }

    // dd/MM/yyyy -> yyyyMMdd
    function dateKeyOf(date) {
      return date.split('/')[2] + date.split('/')[1] + date.split('/')[0];
    }

    function orderPath(day, count) {
      return /databases/$(database)/documents/orders/$('EVT-' + day + '-' + pad4(count));
    }

    // Admin membership: readable by the account itself (the admin app checks
    // it at login), never writable from an app.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Client profiles (name, phone). Each client manages their own; the
    // email must be the one of the signed-in account. Deletion goes through
    // the app, which anonymizes the orders first.
    function isValidProfile(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'email', 'phone'])
        && data.keys().hasAll(['firstName', 'lastName', 'email', 'phone'])
        && isShortString(data.firstName, 1, 100)
        && isShortString(data.lastName, 1, 100)
        && data.email is string
        && data.email.lower() == request.auth.token.email.lower()
        && data.phone is string
        && data.phone.matches('^0[0-9]{9}$');
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && isValidProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Catalogue and bookable dates: everyone signed in reads, admins write.
    function isValidProduct(data) {
      return data.keys().hasOnly(['name', 'description', 'unitPrice', 'enabled', 'category'])
        && isShortString(data.name, 1, 200)
        && isShortString(data.description, 0, 2000)
        && data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 10000
        && data.enabled is bool
        && isShortString(data.category, 0, 100);
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidSlot(dateKey, data) {
      return dateKey.matches('^[0-9]{8}$')
        && data.keys().hasOnly(['date', 'services'])
        && data.date is string && data.date.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4}$')
        && data.services is list
        && data.services.hasOnly(['Midi', 'Soir']);
    }

    match /slots/{dateKey} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && isValidSlot(dateKey, request.resource.data);
      allow delete: if isAdmin();
    }

    // Daily reservation-number counter. It can only go up by one, and only
    // in the same transaction that creates the order carrying that number,
    // so nobody can reset it or skip numbers.
    match /counters/{day} {
      allow read: if signedIn();
      allow create: if signedIn()
        && day.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1
        && existsAfter(orderPath(day, 1));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && existsAfter(orderPath(day, request.resource.data.count));
      allow delete: if false;
    }

    function isValidNewOrder(reservationNumber, data) {
      let day = reservationNumber.split('-')[1];
      let slot = /databases/$(database)/documents/slots/$(dateKeyOf(data.date));
      return reservationNumber.matches('^EVT-[0-9]{8}-[0-9]{4}$')
        // The number is the one the counter moves to in this transaction.
        && getAfter(/databases/$(database)/documents/counters/$(day)).data.count is int
        && pad4(getAfter(/databases/$(database)/documents/counters/$(day)).data.count)
             == reservationNumber.split('-')[2]
        && data.keys().hasOnly(['uid', 'date', 'service', 'total', 'email', 'clientName',
                                'clientPhone', 'status', 'products', 'createdAt'])
        && data.keys().hasAll(['uid', 'date', 'service', 'total', 'email', 'clientName',
                               'clientPhone', 'status', 'products', 'createdAt'])
        && data.uid == request.auth.uid
        && data.status == 'En attente'
        && data.createdAt == request.time
        && data.email is string && data.email.lower() == request.auth.token.email.lower()
        && isShortString(data.clientName, 0, 201)
        && isShortString(data.clientPhone, 0, 20)
        && data.total is number && data.total >= 0 && data.total <= 10000
        && data.products is list && data.products.size() >= 1 && data.products.size() <= 30
        // A date/service the restaurateur opened, not in the past.
        && data.date is string && data.date.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4}$')
        && dateKeyOf(data.date) >= todayKey()
        && data['service'] in ['Midi', 'Soir']
        && exists(slot)
        && data['service'] in get(slot).data.services;
    }

    // Anonymization done by the app when a client deletes their account.
    function isAnonymization() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uid', 'email', 'clientName', 'clientPhone'])
        && request.resource.data.uid == 'deleted'
        && request.resource.data.email == ''
        && request.resource.data.clientName == 'Compte supprime'
        && request.resource.data.clientPhone == '';
    }

    match /orders/{reservationNumber} {
      // A client sees only their own orders; admins see all.
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn() && isValidNewOrder(reservationNumber, request.resource.data);

      // Admins change the status; a client can only anonymize their own
      // orders (account deletion).
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['En attente', 'En preparation', 'Prete', 'Remise'])
        || (signedIn() && resource.data.uid == request.auth.uid && isAnonymization());

      allow delete: if false;
    }
  }
}
